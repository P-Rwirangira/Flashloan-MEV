# Base MEV Platform Environment Configuration

# Node Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Base Network Configuration
# Use a reliable RPC provider - public RPCs are rate-limited and unreliable
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BASE_WS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BASE_CHAIN_ID=8453

# Fallback RPC Endpoints (REQUIRED for production)
# Get API keys from: https://www.alchemy.com/ or https://infura.io/
ALCHEMY_BASE_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
INFURA_BASE_URL=https://base-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Base Sepolia Testnet (for testing)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Private Relay Configuration
# bloXroute API key for private transaction submission
# Get your API key from: https://bloxroute.com/
BLOXROUTE_API_KEY=your_bloxroute_api_key_here

# Flashbots auth signer private key (can be any private key for reputation)
# This is NOT your trading wallet - it's just for authentication
# Leave empty to generate a random one
FLASHBOTS_AUTH_KEY=your_flashbots_auth_signer_private_key_here

# Flashbots Protect RPC URL
FLASHBOTS_PROTECT_URL=https://rpc.flashbots.net

# Strategy Configuration
MIN_PROFIT_USD=15
MAX_SLIPPAGE_BPS=100
MAX_GAS_PRICE_GWEI=0.1

# Monitoring
METRICS_PORT=3001
HEALTH_CHECK_PORT=3002
HEALTH_HOST=0.0.0.0

# Health Check Configuration
# Health check interval in milliseconds (default: 30000)
HEALTH_CHECK_INTERVAL_MS=30000
# Number of consecutive failures before marking unhealthy (default: 3)
HEALTH_UNHEALTHY_THRESHOLD=3
# Number of consecutive failures before marking degraded (default: 2)
HEALTH_DEGRADED_THRESHOLD=2

# Security
# Primary app execution key (KEEP SECRET - funds MEV operations)
# Use a DEDICATED wallet with LIMITED funds (0.5 ETH max for testing)
EXECUTION_PRIVATE_KEY=your_private_key_here
# Backward-compatible fallback (used if EXECUTION_PRIVATE_KEY is unset)
PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# Smart Contract Addresses
# FlashExecutor contract address (deploy with: npm run deploy:mainnet)
FLASH_EXECUTOR_ADDRESS=

# BaseScan API Key (for contract verification)
# Get from: https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here