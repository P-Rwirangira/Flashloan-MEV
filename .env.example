# Base MEV Platform Environment Configuration

# Node Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Base Network Configuration
BASE_RPC_URL=http://localhost:8545
BASE_WS_URL=ws://localhost:8546
BASE_CHAIN_ID=8453

# Fallback RPC Endpoints
ALCHEMY_BASE_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
INFURA_BASE_URL=https://base-mainnet.infura.io/v3/YOUR_PROJECT_ID

# Private Relay Configuration
BLOXROUTE_API_KEY=your_bloxroute_api_key
FLASHBOTS_PROTECT_URL=https://rpc.flashbots.net

# Strategy Configuration
MIN_PROFIT_USD=20
MAX_SLIPPAGE_BPS=50
MAX_GAS_PRICE_GWEI=10

# Monitoring
METRICS_PORT=3001
HEALTH_CHECK_PORT=3002

# Security
PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=your_wallet_address_here